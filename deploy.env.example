# Copy to .env next to compose.yaml on the server, then: docker compose up -d --build
# Every setting has a default except the database password.

# Required: the Postgres password (any long random string; openssl rand -base64 30).
POSTGRES_PASSWORD=change-me

# Where the app listens. Home network by default; 127.0.0.1 when only a reverse proxy on this host should reach it.
# MISE_LISTEN=0.0.0.0
# MISE_PORT=8080

# HTTPS from the stack's own Caddy (docs/deploy.md section 7). Phones need HTTPS to open the shopping list offline.
# COMPOSE_PROFILES=https makes every docker compose command include Caddy. Set PUBLIC_BASE_URL=https://<MISE_HOST>
# below and MISE_LISTEN=127.0.0.1 above with it. MISE_TLS is `internal` (Caddy's own certificate authority, for a
# home network: each phone trusts its root once) or a contact email for a public Let's Encrypt certificate
# (MISE_HOST in public DNS, pointing here, with ports 80 and 443 open to the internet).
# COMPOSE_PROFILES=https
# MISE_HOST=mise.example.com
# MISE_TLS=internal

# Photos. The LXC's own disk by default; another disk or an NFS/SMB mount works too. Must be writable by MISE_UID.
# MEDIA_DIR=./data/media
# A recipe archive to import photos from (mounted read-only at /archive).
# ARCHIVE_DIR=./data/archive
# MISE_UID=10001
# MISE_GID=10001

# Sign-in: local, oidc, or local,oidc. See docs/sign-in.md.
# AUTH_MODES=local
# PUBLIC_BASE_URL=https://mise.example.com
# SESSION_DAYS=30
# OIDC_ISSUER=https://auth.example.com/application/o/mise/
# OIDC_CLIENT_ID=mise
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# OIDC_SCOPES=email profile
# OIDC_ADMIN_GROUP=mise-admins
# OIDC_HOUSEHOLD=Home

# Nightly database backups.
# BACKUP_DIR=./backups
# BACKUP_DAYS=14
# BACKUP_HOUR=3
