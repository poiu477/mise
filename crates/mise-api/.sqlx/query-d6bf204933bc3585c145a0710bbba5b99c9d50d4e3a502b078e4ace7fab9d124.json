  "query": "SELECT f.id, f.name FROM foods f\n         WHERE known_food(f, $1) AND (f.name ILIKE '%' || $2 || '%' OR f.name % $2)\n         ORDER BY f.name ILIKE $2 || '%' DESC, similarity(f.name, $2) DESC, f.name\n         LIMIT $3",
