  "query": "SELECT il.text,\n                  il.raw_name,\n                  il.note,\n                  la.amount::float8 AS \"amount?\",\n                  la.unit AS \"unit?\",\n                  f.id AS \"food_id?\",\n                  f.name AS \"food?\"\n           FROM ingredient_lines il\n           LEFT JOIN line_amounts la ON la.line_id = il.id\n           LEFT JOIN foods f ON f.id = il.food_id\n           WHERE il.variant_id = $1 ORDER BY il.position",
