  "query": "SELECT la.line_id AS \"line_id!\",\n                  la.servings::float8 AS \"servings!\",\n                  la.amount::float8 AS \"amount!\",\n                  la.unit AS \"unit?\"\n           FROM line_amounts la\n           JOIN ingredient_lines il ON il.id = la.line_id WHERE il.variant_id = ANY($1) AND la.amount > 0",
