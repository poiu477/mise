#!/usr/bin/env bash
# Runs CI's build, lint and test steps (.github/workflows/ci.yml) with CI's commands and flags, in CI's order, and
# stops at the first failure, naming it.
#
#   ./check          formatting, lints, tests, the Rust docs, the API document check, then the web app's format, lint,
#                    tests, build
#   ./check --e2e    all of that, then the browser journeys
#   ./check --fast   formatting and lints only (what .githooks/pre-commit runs)
#
# The Rust tests need Postgres (DATABASE_URL, from the environment or .env; see docs/development.md). Locally the API
# tests skip when it is missing; here, as in CI, that is a failure.
#
# CI-only, never run here: `cargo deny`, `npm audit`, the Docker image build and publishing the docs to GitLab Pages.
set -euo pipefail

usage() {
  sed -n '2,13s/^# \{0,1\}//p' "$0"
}

fast=false
e2e=false
for arg in "$@"; do
  case "$arg" in
    --fast) fast=true ;;
    --e2e) e2e=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "check: unknown option '$arg'" >&2
      usage >&2
      exit 2
      ;;
  esac
done
if $fast && $e2e; then
  echo "check: --fast and --e2e don't go together" >&2
  exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$root"

if [ -t 1 ]; then
  bold=$'\e[1m' red=$'\e[31m' green=$'\e[32m' reset=$'\e[0m'
else
  bold='' red='' green='' reset=''
fi

current=''
started=$SECONDS
step() {
  current="$1"
  printf '\n%s==> %s%s\n' "$bold" "$current" "$reset"
}
on_exit() {
  local status=$?
  if [ "$status" -ne 0 ] && [ -n "$current" ]; then
    printf '\n%scheck: failed at "%s"%s\n' "$red$bold" "$current" "$reset" >&2
  fi
}
trap on_exit EXIT

# The Rust tests read DATABASE_URL from .env themselves, but the browser journeys (web/e2e/serve.mjs) read only the
# environment. Taking it from .env here gives both the same database.
if [ -z "${DATABASE_URL:-}" ] && [ -f .env ]; then
  url="$(sed -n 's/^[[:space:]]*DATABASE_URL[[:space:]]*=[[:space:]]*//p' .env | tail -n 1 | tr -d '\r')"
  url="${url%\"}" url="${url#\"}" url="${url%\'}" url="${url#\'}"
  if [ -n "$url" ]; then
    export DATABASE_URL="$url"
  fi
fi

# CI installs the web app's packages with `npm ci` each run. Here that happens only when they are missing or older
# than web/package-lock.json (npm writes node_modules/.package-lock.json on each install), so a local run doesn't
# throw away node_modules every time but doesn't test against stale packages either.
web_packages() {
  if [ ! -f web/node_modules/.package-lock.json ] || [ web/package-lock.json -nt web/node_modules/.package-lock.json ]; then
    step "Web packages (npm ci)"
    (cd web && npm ci --no-audit --no-fund)
  fi
}

# The fast part: formatting and lints.
step "Rust formatting"
cargo fmt --all --check

step "Clippy"
cargo clippy --workspace --all-targets --locked -- -D warnings

if $fast; then
  web_packages
  step "Web formatting"
  (cd web && npm run --silent format:check)
  step "Web lint"
  (cd web && npm run --silent lint)
  current=''
  printf '\n%scheck --fast: passed in %ss%s\n' "$green$bold" "$((SECONDS - started))" "$reset"
  exit 0
fi

step "Rust tests"
# CI set, as in CI, for every test step: the API tests fail, rather than skip, when the database is missing or
# unreachable, and Vitest and Playwright refuse a focused test (.only) instead of quietly running just that one.
CI="${CI:-true}" cargo test --workspace --locked

step "Rust docs"
# As CI's `rust docs` job: a broken intra-doc link or bad doc markup fails it.
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked

web_packages
step "API document is valid and the web types match it"
cargo run -q --locked -p mise-api -- openapi >web/openapi.json
(cd web && node scripts/check-openapi.mjs)
# As CI does it: regenerate src/api/schema.d.ts in place and fail if it differs from git's copy. On a failure the
# regenerated file is left in place, ready to commit.
(cd web && npx --no-install openapi-typescript openapi.json -o src/api/schema.d.ts >/dev/null)
if ! git diff --exit-code -- web/src/api/schema.d.ts; then
  echo "web/src/api/schema.d.ts was out of date; it has been regenerated (the diff above) for you to commit" >&2
  exit 1
fi

step "Web formatting"
(cd web && npm run --silent format:check)

step "Web lint"
(cd web && npm run --silent lint)

step "Web tests"
(cd web && CI="${CI:-true}" npm test --silent)

step "Type check and build"
(cd web && npm run --silent build)

if $e2e; then
  step "Build mise and mise-server for the browser journeys"
  cargo build --locked -p mise-cli -p mise-api
  step "Browser journeys"
  # The list reporter, since under CI the config picks GitHub annotations.
  (cd web && CI="${CI:-true}" npm run --silent e2e -- --reporter=list)
fi

current=''
printf '\n%scheck: passed in %ss%s\n' "$green$bold" "$((SECONDS - started))" "$reset"
