/target
.env
*.log
# Seed bundles are generated locally from private sources and never committed.
/seed/
# Gate and other reports contain personal data (decisions, titles from private sources).
/reports/
# Agent worktrees
/.claude/
# Web app: dependencies, build output, and the spec copy its types are generated from
/web/node_modules/
/web/dist/
/web/openapi.json
/web/*.tsbuildinfo
# Production stack data and backups (compose.yaml defaults)
/data/
/backups/
# Playwright output
/web/playwright-report/
/web/test-results/
