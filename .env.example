# Copy to .env for local development.
# The demo recipes' database; docs/development.md ("First setup") creates and loads it.
DATABASE_URL=postgres://mise:mise@localhost:5433/mise_demo
# Where photos and other media are stored. Defaults to a local directory; can be another disk or a network mount.
# Put it on the same volume as any photo folder you import from, so originals are hard-linked rather than copied.
MEDIA_ROOT=./data/media
RUST_LOG=info,sqlx=error
# mise-server: address to listen on (home network by default), and whether to apply migrations at start.
MISE_BIND=0.0.0.0:8080
MISE_MIGRATE=true

# Sign-in. The first visit to the web app creates the admin account; `mise user` manages accounts from the server.
# local = username and password; oidc = single sign-on (see docs/sign-in.md). Both: local,oidc
AUTH_MODES=local
# Set when mise is reached through a reverse proxy; https here also marks session cookies Secure.
# PUBLIC_BASE_URL=https://mise.example.com
# SESSION_DAYS=30
# OIDC_ISSUER=https://auth.example.com/application/o/mise/
# OIDC_CLIENT_ID=mise
# OIDC_CLIENT_SECRET=...
# OIDC_NAME=Authentik
# OIDC_SCOPES=email profile
# OIDC_ADMIN_GROUP=mise-admins
# OIDC_HOUSEHOLD=Home
