# Copy to .env for local development.
DATABASE_URL=postgres://mise:mise@localhost:5433/mise
# Where photos and other media are stored. Defaults to a local directory; can be another disk or a network mount.
# Put it on the same volume as the recipe archive (e.g. D:/mise-media for D:/Recipes) so originals are hard-linked
# rather than copied.
MEDIA_ROOT=./data/media
RUST_LOG=info,sqlx=error
# mise-server: address to listen on (home network by default), and whether to apply migrations at start.
MISE_BIND=0.0.0.0:8080
MISE_MIGRATE=true
