# Copy to .env for local development.
# The demo recipes' database; docs/development.md ("First setup") creates and loads it.
DATABASE_URL=postgres://mise:mise@localhost:5433/mise_demo
# Where photos and other media are stored. Defaults to a local directory; can be another disk or a network mount.
# Put it on the same volume as any photo folder you import from, so originals are hard-linked rather than copied.
MEDIA_ROOT=./data/media
RUST_LOG=info,sqlx=error
# mise-server: address to listen on (home network by default), and whether to apply migrations at start.
MISE_BIND=0.0.0.0:8080
MISE_MIGRATE=true
# Import from a link: true lets imports fetch from private and local addresses too (docs/deploy.md section 8).
# IMPORT_ALLOW_PRIVATE=false
# Sharing: the most a household may share its recipes with: private, partners or install (docs/deploy.md section 9).
# SHARING_MAX_LEVEL=install
# Logs: text (the default), or json for one JSON object a line, for a log collector (docs/deploy.md section 11).
# MISE_LOG_FORMAT=text
# Prometheus metrics on a port of their own, for a scraper on the private network; unset serves none.
# MISE_METRICS_BIND=0.0.0.0:9090

# Sign-in. The first visit to the web app creates the admin account; `mise user` manages accounts from the server.
# local = username and password; oidc = single sign-on (see docs/sign-in.md). Both: local,oidc
AUTH_MODES=local
# Set when mise is reached through a reverse proxy; https here also marks session cookies Secure.
# PUBLIC_BASE_URL=https://mise.example.com
# SESSION_DAYS=30
# OIDC_ISSUER=https://auth.example.com/application/o/mise/
# OIDC_CLIENT_ID=mise
# OIDC_CLIENT_SECRET=...
# OIDC_NAME=Authentik
# OIDC_SCOPES=email profile
# OIDC_ADMIN_GROUP=mise-admins
# OIDC_HOUSEHOLD=Home
# Who signing on lets in: members of this group (with OIDC_ADMIN_GROUP's), who get an account at their first sign-in.
# Unset, only people with an account here sign in, unless OIDC_OPEN_SIGNUP=true lets anyone the provider vouches for
# make one (only for a provider whose every user is yours, never a public one such as Google).
# OIDC_ALLOWED_GROUP=mise-users
# OIDC_OPEN_SIGNUP=false
