  "tool": [],
  "recipeIngredient": [
    "1 onion, chopped",
    "2 garlic cloves, crushed",
    "1 TBSP curry powder",
    "1 cup red lentils, rinsed",
    "4 cups vegetable stock",
    "1 can coconut milk"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Soften the onion and garlic in a little oil, then stir in the curry powder." },
    { "@type": "HowToStep", "text": "Add the lentils and stock and simmer for 20 minutes, until the lentils collapse." },
    { "@type": "HowToStep", "text": "Stir in the coconut milk and blend until smooth." }
  ],
