  "tool": [],
  "recipeIngredient": [
    "1 cup pearl barley",
    "1 cucumber, diced",
    "1 bunch parsley, chopped",
    "2 lemons, juiced",
    "3 TBSP olive oil",
    "1 tsp salt"
  ],
  "recipeInstructions": [
    "Simmer the barley in plenty of salted water for 30 minutes, until tender. Drain and cool.",
    "Whisk the lemon juice, olive oil and salt.",
    "Toss the barley with the cucumber, parsley and dressing."
  ],
